  global 
    maxconn 2000
  defaults
    timeout connect 5s
    timeout client 50s
    timeout server 50s

  frontend myfrontend
    mode http
    bind *:80
    bind *:443 ssl crt /etc/haproxy/certs/www.jlmushumba.tech.pem
    default_backend web-servers

  backend web-servers
    mode http
    balance roundrobin
    option httpchk GET /
    server web-01 18.170.79.166:80 check
    server web-02 3.8.124.233:80 check
